NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional — required only for instant "New User" account creation
# (Setup > Users & Roles). Without it, that page falls back to the
# invite-and-self-signup flow. Get it from Supabase Dashboard >
# Settings > API > Secret keys (or the legacy "service_role" key under
# the "Legacy anon, service_role" tab). NEVER commit the real value —
# this file only documents the variable name.
SUPABASE_SERVICE_ROLE_KEY=
# Required for Web Push (OS-level notifications, works even when the app
# isn't open). Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser by design (that's
# what "public" means here); VAPID_PRIVATE_KEY must stay a server secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
