NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional — required only for instant "New User" account creation
# (Setup > Users & Roles). Without it, that page falls back to the
# invite-and-self-signup flow. Get it from Supabase Dashboard >
# Settings > API > Secret keys (or the legacy "service_role" key under
# the "Legacy anon, service_role" tab). NEVER commit the real value —
# this file only documents the variable name.
SUPABASE_SERVICE_ROLE_KEY=
# Required for Web Push (OS-level notifications, works even when the app
# isn't open). Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser by design (that's
# what "public" means here); VAPID_PRIVATE_KEY must stay a server secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required for Incoming Documents (email RFQ/PR/PO intake, via Mailgun
# Routes). Any random string — generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Put the SAME value in the Mailgun Route's forward-to webhook URL as
# ?token=<this value>. Never commit the real value.
INBOUND_EMAIL_WEBHOOK_SECRET=
# Optional, extra hardening on top of the token above: Mailgun's own
# per-request HMAC-SHA256 signature. Find it in the Mailgun dashboard
# under Sending > Webhooks > "HTTP webhook signing key" (same key for
# every webhook on the account). Leave blank to skip this check — the
# token above still gates the endpoint either way.
MAILGUN_WEBHOOK_SIGNING_KEY=
